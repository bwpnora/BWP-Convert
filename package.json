{
  "name": "bwp-convert",
  "version": "1.1.0",
  "description": "Opera PMS XML to Excel Converter for Vietnamese and Foreign Police Stay Reports",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/**/*.test.js",
    "convert": "node src/cli.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.3",
    "readable-stream": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bwpconvert.app",
    "productName": "BWP Convert",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/images/logo.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BWP Convert",
      "uninstallDisplayName": "BWP Convert - Gỡ cài đặt"
    },
    "extraResources": [
      {
        "from": "brief",
        "to": "brief",
        "filter": [
          "*.xlsx"
        ]
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
